<?xml version='1.0' encoding='utf-8'?>
<build-type xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" uuid="0c3f1181-bad7-4954-b1fc-6fbeab230024" xsi:noNamespaceSchemaLocation="https://www.jetbrains.com/teamcity/schemas/2025.3/project-config.xsd">
  <name>Build</name>
  <description />
  <settings>
    <options>
      <option name="artifactRules" value="target/plaindoll-*.jar =&gt; jars" />
    </options>
    <build-runners>
      <runner id="MAVEN_DEPLOY" name="Master: clean deploy" type="Maven2">
        <conditions>
          <equals name="teamcity.build.branch" value="master" />
        </conditions>
        <parameters>
          <param name="goals" value="clean deploy" />
          <param name="maven.path" value="%teamcity.tool.maven.DEFAULT%" />
          <param name="pomLocation" value="pom.xml" />
          <param name="userSettingsSelection" value="settings.xml" />
        </parameters>
      </runner>
      <runner id="MAVEN_TEST" name="Other branches: clean test" type="Maven2">
        <conditions>
          <does-not-equal name="teamcity.build.branch" value="master" />
        </conditions>
        <parameters>
          <param name="goals" value="clean test" />
          <param name="maven.path" value="%teamcity.tool.maven.DEFAULT%" />
          <param name="pomLocation" value="pom.xml" />
          <param name="userSettingsSelection" value="settings.xml" />
        </parameters>
      </runner>
    </build-runners>
    <vcs-settings>
      <vcs-entry-ref root-id="Netology_ExampleTeamcity" />
    </vcs-settings>
    <build-triggers>
      <build-trigger id="TRIGGER_1" type="vcsTrigger">
        <parameters>
          <param name="branchFilter" value="+:*" />
          <param name="enableQueueOptimization" value="true" />
          <param name="quietPeriod" value="10" />
          <param name="quietPeriodMode" value="USE_CUSTOM" />
        </parameters>
      </build-trigger>
    </build-triggers>
  </settings>
</build-type>
